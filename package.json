{
  "name": "disfruleg-bodega",
  "version": "1.0.0",
  "description": "Portal web para el encargado de bodega — Disfruleg",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "lsof -ti :3030 | xargs kill -9 2>/dev/null; node --watch server.js",
    "build:css": "tailwindcss -i public/css/tailwind.css -o public/css/tailwind.min.css --minify",
    "build:js": "node scripts/bundle-js.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i public/css/tailwind.css -o public/css/tailwind.min.css --watch",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "forceExit": true,
    "testMatch": ["**/tests/**/*.test.js"],
    "testPathIgnorePatterns": ["/node_modules/", "/.claude/"]
  },
  "dependencies": {
    "@tidbcloud/serverless": "^0.3.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.9.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.110.0"
  }
}
